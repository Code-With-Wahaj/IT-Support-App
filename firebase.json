{
  "flutter": {
    "platforms": {
      "android": {
        "default": {
          "projectId": "aptech-network-hub",
          "appId": "1:143525196824:android:e87861657749bcc9fdff6d",
          "fileOutput": "android/app/google-services.json"
        }
      },
      "dart": {
        "lib/firebase_options.dart": {
          "projectId": "aptech-network-hub",
          "configurations": {
            "android": "1:143525196824:android:e87861657749bcc9fdff6d",
            "web": "1:143525196824:web:7e0bffa063097dbcfdff6d",
            "windows": "1:143525196824:web:6cdc5c222e76a8defdff6d"
          }
        }
      }
    }
  },
  "hosting": {
    "public": "build/web",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "headers": [
      {
        "source": "**",
        "headers": [
          {
            "key": "X-Content-Type-Options",
            "value": "nosniff"
          },
          {
            "key": "X-Frame-Options",
            "value": "DENY"
          },
          {
            "key": "X-XSS-Protection",
            "value": "1; mode=block"
          },
          {
            "key": "Referrer-Policy",
            "value": "strict-origin-when-cross-origin"
          },
          {
            "key": "Permissions-Policy",
            "value": "camera=(), microphone=(), geolocation=()"
          }
        ]
      }
    ],
    "rewrites": [
      {
        "source": "**",
        "destination": "/index.html"
      }
    ]
  },
  "firestore": {
    "rules": "firestore.rules"
  }
}
